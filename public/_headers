# Cloudflare Pages: cabeçalhos das respostas estáticas (herdados do website-portfolio).
# Não valem para a Pages Function (/api/*): ela manda os próprios (functions/api/now-playing.ts).
#
# O marcador de hashes no script-src é trocado no build por scripts/csp.mjs (hash de cada <script> inline do out/).
# style-src precisa de 'unsafe-inline': o React escreve style="" no HTML e a estante (motion) mexe em estilo.
# img-src: as capas do Spotify vêm de i.scdn.co; o grão dos placeholders é um data: SVG.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' __SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.scdn.co; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Arquivos com hash no nome nunca mudam.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
