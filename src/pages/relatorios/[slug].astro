---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import ReportView from '../../components/ReportView.astro';
import { reportPaths } from '../../lib/reports';

export const getStaticPaths = (() => reportPaths('pt')) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { report, hasTranslation } = Astro.props as Props;
---

<ReportView lang="pt" report={report} hasTranslation={hasTranslation} />
