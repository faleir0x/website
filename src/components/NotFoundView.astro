---
import BaseLayout from '../layouts/BaseLayout.astro';
import { kaomoji, notFoundCopy } from '../i18n/not-found';
import { routes } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import notFoundScript from '../scripts/not-found.js?raw';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = notFoundCopy[lang];
---

<BaseLayout lang={lang} title="404" description={t.description} view="portfolio" noindex>
  <div class="not-found">
    <p class="code">404</p>
    <h1 id="kaomoji">{kaomoji[0]}</h1>
    <p class="message">{t.message}</p>
    <p class="back"><a id="go-back" href={routes.portfolio[lang]}>{t.back}</a></p>
  </div>
  <script is:inline id="kaomoji-list" type="application/json" set:html={JSON.stringify(kaomoji)} />
  <script is:inline set:html={notFoundScript} />
</BaseLayout>

<style>
  /* Let the content fill the space between header and footer so it can centre vertically. */
  :global(main:has(> .not-found)) {
    display: flex;
    flex-direction: column;
  }
  .not-found {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(34px, 6vh, 56px) 0;
  }
  /* Free space splits 1:2 above/below, so the block sits in the upper third. */
  .not-found::before,
  .not-found::after {
    content: "";
  }
  .not-found::before {
    flex: 1 1 0;
  }
  .not-found::after {
    flex: 2 1 0;
  }

  /* Kicker treatment, one step up. */
  .code {
    margin: 0 0 14px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    opacity: 0.9;
  }
  /* Masthead title treatment; kaomoji are long, so they scale down instead of wrapping. */
  h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(44px, 12vw, 104px);
    letter-spacing: -0.015em;
    line-height: 1.02;
    white-space: nowrap;
  }
  .message {
    margin: clamp(24px, 4vh, 36px) 0 0;
    font-size: clamp(20px, 3vw, 26px);
    line-height: 1.5;
    opacity: 0.7;
    text-wrap: balance;
  }
  /* Footer view-switch link treatment. */
  .back {
    margin: clamp(28px, 4.5vh, 44px) 0 0;
    font-size: 17px;
  }
  .back a {
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
  }
</style>
