---
import { ui, type Lang } from '../i18n/ui';
import { routes, type View } from '../i18n/routes';

interface Props {
  lang: Lang;
  view: View;
}

const { lang, view } = Astro.props;
const t = ui[lang];

// The switch points at the other view; its label names that view.
const target: View = view === 'portfolio' ? 'reports' : 'portfolio';

const profiles = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/cauefaleiros/' },
  { label: 'GitHub', href: 'https://github.com/faleir0x' },
  { label: 'HackerOne', href: 'https://hackerone.com/faleir0x' },
  { label: 'TryHackMe', href: 'https://tryhackme.com/p/faleir0x' },
];
---

{/*
  Phones: the sticky bar keeps the email, resume and view switch; the profile
  links sit in this row at the end of the page instead. Desktop shows everything
  in the sticky bar and hides this row.
*/}
<nav class="profiles" aria-label="Profiles">
  {
    profiles.map((p) => (
      <a href={p.href} target="_blank" rel="noopener">
        {p.label}
      </a>
    ))
  }
</nav>

<footer>
  <a class="contact" href="mailto:contact@faleir0x.com">contact@faleir0x.com</a>
  {
    profiles.map((p) => (
      <a class="secondary" href={p.href} target="_blank" rel="noopener">
        {p.label}
      </a>
    ))
  }
  {/* /{lang}/resume/ redirects to public/{lang}/resume.pdf (public/_redirects). */}
  <a class="secondary resume" href={`/${lang}/resume/`}>{t.cv}</a>
  <a class="switch" href={routes[target][lang]}>{t[target]}</a>
</footer>

<style>
  footer {
    position: sticky;
    bottom: 0;
    flex: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 26px;
    align-items: baseline;
    margin: 0 calc(-1 * clamp(22px, 5vw, 34px));
    padding: 20px clamp(22px, 5vw, 34px);
    background: var(--bg);
    border-top: 1px solid color-mix(in srgb, currentColor 16%, transparent);
    font-size: 15px;
  }
  .contact {
    border-bottom: 1px solid var(--ink);
    padding-bottom: 1px;
  }
  .secondary {
    opacity: 0.7;
  }
  .secondary:hover {
    opacity: 1;
  }
  .switch {
    margin-left: auto;
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .profiles {
    display: none;
  }

  /* Below this width the full row no longer fits on one line. */
  @media (max-width: 759px) {
    /* One row: email on the left; resume and view switch together on the right.
       14px from 350px down so it still fits a 320px screen. */
    footer {
      flex-wrap: nowrap;
      gap: 14px;
      font-size: clamp(14px, 4.3vw, 15px);
    }
    .secondary:not(.resume) {
      display: none;
    }
    .resume {
      margin-left: auto;
    }
    .switch {
      margin-left: 0;
    }

    /* Section-rule pattern; the four profiles spread across one line. */
    .profiles {
      flex: none;
      display: flex;
      justify-content: space-between;
      gap: 8px;
      padding: 22px 0 26px;
      border-top: 1px solid color-mix(in srgb, currentColor 16%, transparent);
      font-size: clamp(14px, 4.3vw, 15px);
    }
    .profiles a {
      white-space: nowrap;
      opacity: 0.7;
    }
    .profiles a:hover {
      opacity: 1;
    }
  }
</style>
