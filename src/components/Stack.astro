---
import Band from './Band.astro';
import { portfolioCopy, stack } from '../i18n/portfolio';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Band label={portfolioCopy[lang].stackLabel}>
  <dl>
    {
      stack.map((row) => (
        <>
          <dt>{row.label}</dt>
          <dd class:list={{ muted: row.muted }}>
            {(Array.isArray(row.items) ? row.items : row.items[lang]).join(' · ')}
          </dd>
        </>
      ))
    }
  </dl>
</Band>

<style>
  dl {
    display: grid;
    grid-template-columns: 78px minmax(0, 1fr);
    gap: 12px 24px;
    margin: 0;
  }
  dt {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.6;
    padding-top: 3px;
  }
  dd {
    min-width: 0;
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
  }
  .muted {
    opacity: 0.7;
  }
</style>
