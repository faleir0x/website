---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { htmlLang, langs, otherLang, type Lang } from '../i18n/ui';
import { routes, rssPath, type View } from '../i18n/routes';
import { reportsCopy } from '../i18n/reports';
import themeScript from '../scripts/theme.js?raw';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Which side of the Portfolio/Reports switch this page belongs to. */
  view: View;
  /**
   * Path of this page in the other language.
   * - omitted: the other language's page for `view` (index pages).
   * - null: no translation exists — the language toggle falls back to that
   *   index, and no hreflang alternates are emitted.
   */
  translation?: string | null;
  /** Write-up pages: Open Graph type "article" with these dates. */
  article?: { published: Date; modified?: Date };
  /** Error pages: no canonical, no alternates, not indexed. */
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  view,
  translation = routes[view][otherLang(lang)],
  article,
  noindex = false,
} = Astro.props;

const other = otherLang(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const toggleHref = translation ?? routes[view][other];

const ogLocale = { en: 'en_US', pt: 'pt_BR' } as const;

const alternates =
  translation === null || noindex
    ? []
    : [
        { lang, href: canonical.href },
        { lang: other, href: new URL(translation, Astro.site).href },
      ];
const xDefault = alternates.find((a) => a.lang === langs[0]);
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Theme script: see src/scripts/theme.js. Inline + synchronous = no light flash. */}
    <script is:inline set:html={themeScript} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={htmlLang[a.lang]} href={a.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault.href} />}
    <link rel="alternate" type="application/rss+xml" title={reportsCopy[lang].pageTitle} href={rssPath(lang)} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Link previews (LinkedIn, Discord, X…). Text-only: the site has no images. */}
    <meta property="og:site_name" content="faleir0x" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={ogLocale[lang]} />
    {alternates.length > 0 && <meta property="og:locale:alternate" content={ogLocale[other]} />}
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
    <meta name="twitter:card" content="summary" />

    <Font cssVariable="--font-barlow" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-newsreader" preload />
  </head>
  <body>
    <div class="shell">
      <div class="column">
        <Header lang={lang} toggleHref={toggleHref} />
        <main>
          <slot />
        </main>
        <Footer lang={lang} view={view} />
      </div>
    </div>
  </body>
</html>

<style is:global>
  /* Base type and box model from the design system. Everything that doesn't set
     its own line-height relies on the 1.55 here. */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    font-weight: 400;
  }

  /* Overscroll/rubber-band area matches the theme. */
  html {
    background: var(--bg);
  }

  /* Element-level rules: links, selection, focus. */
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: var(--ink);
  }
  ::selection {
    background: color-mix(in srgb, currentColor 18%, transparent);
  }
  :focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 3px;
  }
</style>

<style>
  .shell {
    min-height: 100vh;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-body);
    transition: background 0.3s ease, color 0.3s ease;
  }
  .column {
    width: 100%;
    max-width: 880px;
    margin: 0 auto;
    box-sizing: border-box;
    padding: 0 clamp(22px, 5vw, 34px);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  main {
    flex: 1 1 auto;
  }
</style>
